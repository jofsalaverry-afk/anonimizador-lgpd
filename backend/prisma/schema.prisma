generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BaseLegal {
  CONSENTIMENTO
  OBRIGACAO_LEGAL
  EXECUCAO_CONTRATO
  INTERESSE_LEGITIMO
  PROTECAO_VIDA
  TUTELA_SAUDE
  INTERESSE_PUBLICO
  EXERCICIO_DIREITOS
}

enum TipoDireito {
  CONFIRMACAO
  ACESSO
  CORRECAO
  ANONIMIZACAO
  PORTABILIDADE
  ELIMINACAO
  INFORMACAO
  REVOGACAO
  OPOSICAO
  PETICAO
  OUTRO
}

enum StatusDSAR {
  RECEBIDA
  AGUARDANDO_VERIFICACAO
  EM_ANALISE
  RESPONDIDA
  ENCERRADA
  CANCELADA
}

enum TipoDocRepo {
  POLITICA
  TERMO
  ADITIVO
  CONTRATO
  MODELO
  OUTRO
  POLITICA_PRIVACIDADE
  POLITICA_SEGURANCA
  MODELO_DSAR
  TERMO_USO
}

enum StatusDocRepo {
  RASCUNHO
  APROVADO
  PUBLICADO
}

enum TipoIncidente {
  VAZAMENTO
  ACESSO_INDEVIDO
  PERDA
  ALTERACAO
  OUTRO
}

enum StatusIncidente {
  ABERTO
  EM_INVESTIGACAO
  RESOLVIDO
  ENCERRADO
}

enum Criticidade {
  ALTA
  MEDIA
  BAIXA
}

enum EvidenciaRequerida {
  DOCUMENTO
  CAPTURA
  AUTO_DECLARACAO
  LINK_SISTEMA
}

enum StatusResposta {
  CONFORME
  PARCIAL
  NAO_CONFORME
  NAO_APLICAVEL
}

enum TipoAlerta {
  DSAR_PRAZO
  CHECKLIST_REVISAO
  INCIDENTE_ABERTO
  ROPA_DESATUALIZADO
  RETENCAO_VENCIDA
}

enum Perfil {
  ENCARREGADO_LGPD
  GESTOR
  OPERADOR
  AUDITOR
  TREINANDO
}

model Organizacao {
  id           String      @id @default(cuid())
  nome         String
  cnpj         String      @unique
  slug         String?     @unique // usado na URL publica /solicitar/:slug
  ativo        Boolean     @default(true)
  plano        String      @default("basico")
  criadoEm     DateTime    @default(now())
  logoBase64   String?
  cabecalho    String?
  municipio    String?
  modulosAtivos  String[]   @default(["anonimizador"])
  setoresPesquisa String[]  @default(["Protocolo", "RH", "Financeiro", "Juridico", "Presidencia", "Outro"])
  // Quando true, usuario sem MFA ativo nao recebe sessao no login: e
  // levado direto para a configuracao do autenticador.
  mfaObrigatorio Boolean    @default(false)
  usuarios       Usuario[]
  documentos     Documento[]
  tratamentos    Tratamento[]
  solicitacoes   SolicitacaoTitular[]
  modelosDSAR    ModeloRespostaDSAR[]
  docsRepo       DocumentoRepositorio[]
  incidentes     Incidente[]
  respostasChecklist RespostaChecklist[]
  alertas        AlertaConformidade[]
  pesquisas      PesquisaSatisfacao[]
  anexos             Anexo[]
  historicos         HistoricoRegistro[]
  setores           Setor[]
  sistemas           SistemaInventario[]
  terceiros          Terceiro[]
  respostasTerceiro  RespostaQuestionarioTerceiro[]
  acoesTerceiro      AcaoTerceiro[]
  progressos         ProgressoTreinamento[]
  certificados       CertificadoTreinamento[]
  providencias       ProvidenciaIncidente[]
  descartes          RegistroDescarte[]
  itensChecklist     ItemChecklist[]
}

model Usuario {
  id             String    @id @default(cuid())
  email          String    @unique
  senhaHash      String
  nome           String
  perfil         Perfil    @default(OPERADOR)
  ativo          Boolean   @default(true)
  // MFA TOTP (Google Authenticator). mfaSecret e populado no setup e
  // mfaAtivo so vira true apos o usuario confirmar o primeiro codigo.
  mfaSecret      String?
  mfaAtivo       Boolean   @default(false)
  criadoEm       DateTime  @default(now())
  ultimoAcesso   DateTime?
  deletedAt      DateTime?
  organizacaoId  String
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id])

  anexosEnviados        Anexo[]
  historicos            HistoricoRegistro[]
  incidentesResponsavel Incidente[]         @relation("IncidenteResponsavel")
  checklistResponsavel  RespostaChecklist[] @relation("ChecklistResponsavel")
  sistemasResponsavel   SistemaInventario[]            @relation("SistemaResponsavel")
  acoesTerceiroResp     AcaoTerceiro[]                 @relation("AcaoTerceiroResponsavel")
  respostasTerceiro     RespostaQuestionarioTerceiro[] @relation("RespostaTerceiroAutor")
  progressos            ProgressoTreinamento[]
  certificados          CertificadoTreinamento[]
  providenciasResp      ProvidenciaIncidente[]         @relation("ProvidenciaResponsavel")
  descartesResp         RegistroDescarte[]             @relation("DescarteResponsavel")
  itensChecklistResp    ItemChecklist[]                @relation("ItemChecklistResponsavel")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  senhaHash String
  criadoEm  DateTime @default(now())
}

model Documento {
  id                 String      @id @default(cuid())
  organizacaoId      String
  organizacao        Organizacao @relation(fields: [organizacaoId], references: [id])
  usuarioId          String?
  tipoDocumento      String
  qtdDadosMascarados Int         @default(0)
  dadosJson          Json?
  criadoEm           DateTime    @default(now())
}

// Trilha de auditoria. Captura toda request mutavel (POST/PUT/PATCH/DELETE)
// autenticada. Imutavel: sem update/delete via API.
model LogAuditoria {
  id         String   @id @default(cuid())
  criadoEm   DateTime @default(now())
  userId     String?
  userType   String?  // "usuario" | "admin"
  camaraId   String?  // legado; equivale a organizacaoId
  metodo     String
  rota       String
  statusCode Int?
  durMs      Int?
  ip         String?
  userAgent  String?
  body       Json?
  hash       String?  // SHA-256 tamper-evidence, ver auditoria.js
  prevHash   String?  // hash da linha anterior na chain (camaraId, userType); null = genesis

  @@index([camaraId, criadoEm])
  @@index([userId, criadoEm])
  @@index([rota, criadoEm])
}

// ============ ROPA (Registro de Operacoes de Tratamento) ============

model Tratamento {
  id                  String      @id @default(cuid())
  organizacaoId       String
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id])
  nome                String
  finalidade          String
  baseLegal           BaseLegal
  categoriasDados     String[]
  categoriasTitulares String[]
  retencaoDias        Int?
  formaDescarte       String?
  responsavelId       String?
  medidasSeguranca    String?
  // Etapa 2 PoC: setor responsavel, sistemas usados (N:N via
  // TratamentoSistema) e meios fora do inventario (papel, arquivo fisico).
  setorId             String?
  setor               Setor?      @relation(fields: [setorId], references: [id], onDelete: SetNull)
  outrosMeios         String?
  ativo               Boolean     @default(true)
  criadoEm            DateTime    @default(now())
  atualizadoEm        DateTime    @updatedAt

  compartilhamentos   CompartilhamentoTratamento[]
  historico           TratamentoHistorico[]
  sistemas            TratamentoSistema[]
  descartes           RegistroDescarte[]

  @@index([organizacaoId, ativo])
}

model CompartilhamentoTratamento {
  id                          String     @id @default(cuid())
  tratamentoId                String
  tratamento                  Tratamento @relation(fields: [tratamentoId], references: [id], onDelete: Cascade)
  terceiroNome                String
  terceiroCNPJ                String?
  finalidadeCompartilhamento  String
  paisDestino                 String     @default("Brasil")
  baseLegalTransferencia      String?
  terceiroId                  String?
  terceiro                    Terceiro?  @relation(fields: [terceiroId], references: [id], onDelete: SetNull)

  @@index([tratamentoId])
}

model TratamentoHistorico {
  id            String     @id @default(cuid())
  tratamentoId  String
  tratamento    Tratamento @relation(fields: [tratamentoId], references: [id], onDelete: Cascade)
  snapshot      Json
  alteradoPor   String
  criadoEm      DateTime   @default(now())

  @@index([tratamentoId, criadoEm])
}

// ============ DSAR (Direitos do Titular) ============

model SolicitacaoTitular {
  id               String      @id @default(cuid())
  organizacaoId    String
  organizacao      Organizacao @relation(fields: [organizacaoId], references: [id])
  protocolo        String      @unique
  titularNome      String
  titularEmail     String
  titularCpf       String?
  tipoDireito      TipoDireito
  descricao        String
  status           StatusDSAR  @default(RECEBIDA)
  dataRecebimento  DateTime    @default(now())
  dataLimite         DateTime?
  dataResposta     DateTime?
  respostaTexto    String?
  responsavelId    String?
  criadoEm         DateTime    @default(now())
  atualizadoEm     DateTime    @updatedAt

  evidencias       EvidenciaDSAR[]

  @@index([organizacaoId, status])
  @@index([protocolo])
  @@index([organizacaoId, dataLimite])
}

model EvidenciaDSAR {
  id             String             @id @default(cuid())
  solicitacaoId  String
  solicitacao    SolicitacaoTitular @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  tipo           String
  descricao      String
  arquivoUrl     String?
  hashSha256     String?
  autorId        String
  criadoEm       DateTime           @default(now())

  @@index([solicitacaoId])
}

model ModeloRespostaDSAR {
  id             String      @id @default(cuid())
  organizacaoId  String
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id])
  tipoDireito    TipoDireito
  titulo         String
  conteudo       String
  padrao         Boolean     @default(false)
  criadoEm       DateTime    @default(now())

  @@index([organizacaoId, tipoDireito])
}

// ============ Repositorio de Documentos e Incidentes ============

model DocumentoRepositorio {
  id             String        @id @default(cuid())
  organizacaoId  String
  organizacao    Organizacao   @relation(fields: [organizacaoId], references: [id])
  tipo           TipoDocRepo
  titulo         String
  descricao      String?       // texto curto mostrado no card
  conteudoMd     String        @default("") // conteudo markdown (legado)
  // Campos de arquivo binario (upload PDF/DOCX). arquivo pode ser null
  // para docs antigos baseados so em conteudoMd.
  arquivo        Bytes?
  mimetype       String?
  nomeArquivo    String?
  tamanhoBytes   Int?
  versao         Int           @default(1)
  status         StatusDocRepo @default(RASCUNHO)
  autorId        String?
  tags           String[]
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt

  @@index([organizacaoId, tipo])
  @@index([organizacaoId, status])
}

model Incidente {
  id              String          @id @default(cuid())
  organizacaoId   String
  organizacao     Organizacao     @relation(fields: [organizacaoId], references: [id])
  titulo          String
  dataOcorrencia  DateTime
  dataDescoberta  DateTime        @default(now())
  tipoIncidente   TipoIncidente
  dadosAfetados   String[]
  qtdTitulares    Int             @default(0)
  notificadoANPD  Boolean         @default(false)
  status          StatusIncidente @default(ABERTO)
  descricao       String
  planoAcao       String?
  autorId         String?
  responsavelId   String?
  responsavel     Usuario?        @relation("IncidenteResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  // Etapa 3 PoC: severidade (reusa Criticidade) e REAL x SIMULADO
  // (simulado de resposta a incidente, conta para o indicador).
  severidade      Criticidade?
  tipoRegistro    TipoRegistroIncidente @default(REAL)
  providencias    ProvidenciaIncidente[]
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  @@index([organizacaoId, status])
}

// ============ Checklist de Conformidade ============

model ItemChecklist {
  id                  String             @id @default(cuid())
  codigo              String             @unique
  categoria           String
  titulo              String
  descricao           String
  fundamentoLegal     String
  obrigatorio         Boolean            @default(true)
  criticidade         Criticidade
  evidenciaRequerida  EvidenciaRequerida
  respostas           RespostaChecklist[]
  // Etapa 3 PoC: organizacaoId null = catalogo global; preenchido =
  // atividade propria daquela organizacao (com responsavel e prazo).
  organizacaoId       String?
  organizacao         Organizacao?       @relation(fields: [organizacaoId], references: [id])
  responsavelId       String?
  responsavel         Usuario?           @relation("ItemChecklistResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  prazo               DateTime?
  criadoEm            DateTime?          @default(now())

  @@index([organizacaoId])
}

model RespostaChecklist {
  id              String         @id @default(cuid())
  organizacaoId   String
  organizacao     Organizacao    @relation(fields: [organizacaoId], references: [id])
  itemId          String
  item            ItemChecklist  @relation(fields: [itemId], references: [id])
  status          StatusResposta
  observacao      String?
  evidenciaUrl    String?
  evidenciaHash   String?
  validadoPor     String?
  responsavelId   String?
  responsavel     Usuario?       @relation("ChecklistResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  proximaRevisao  DateTime?
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt

  @@unique([organizacaoId, itemId])
  @@index([organizacaoId])
}

model AlertaConformidade {
  id             String      @id @default(cuid())
  organizacaoId  String
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id])
  tipo           TipoAlerta
  mensagem       String
  criticidade    Criticidade
  lido           Boolean     @default(false)
  referenciaId   String?
  criadoEm       DateTime    @default(now())

  @@index([organizacaoId, lido])
  @@index([organizacaoId, criadoEm])
}

// ============ DSAR OTP (verificacao de titular) ============
// Guarda dados de solicitacao publica pendente + codigo OTP.
// Quando o titular confirma o codigo, a solicitacao real
// (SolicitacaoTitular) e criada a partir destes dados.
model DsarOtp {
  id             String      @id @default(cuid())
  organizacaoId  String
  email          String
  codigo         String
  titularNome    String
  titularCpf     String?
  tipoDireito    TipoDireito
  descricao      String
  expiresAt      DateTime
  usado          Boolean     @default(false)
  criadoEm       DateTime    @default(now())

  @@index([email, codigo, usado])
  @@index([expiresAt])
}

// ============ Aprendizado do anonimizador ============
// Correcoes de classificacao feitas por usuarios no relatorio de devolutiva.
// Global — aplicadas a todas as organizacoes. Quando o mesmo trecho aparecer
// de novo, o gerarRelatorio usa a classificacao validada em vez da heuristica.
// classificacaoCorreta: "cpf" | "rg" | "email" | "telefone" | "endereco" |
// "nome" | "nao_pessoal".
model DsarAprendizado {
  id                    String   @id @default(cuid())
  trecho                String
  trechoNormalizado     String   // lowercase, para lookup
  classificacaoErrada   String?
  classificacaoCorreta  String
  contexto              String?
  criadoEm              DateTime @default(now())

  @@index([trechoNormalizado])
}

// ============ Treinamento ============
// Override de youtubeId/titulo de modulos das trilhas hardcoded.
// Permite admin curar conteudo sem alterar codigo. Global — afeta
// todas as organizacoes (trilhas sao compartilhadas).
model TrilhaOverride {
  id         String   @id @default(cuid())
  trilhaId   String
  moduloId   String
  youtubeId  String
  titulo     String?
  atualizadoEm DateTime @updatedAt

  @@unique([trilhaId, moduloId])
}

// ============ Pesquisa de Satisfacao (PNTP TCE/RS 15.6) ============

// INVARIANTE LGPD/PNTP 15.6:
// 1. Pesquisa é instrumento anônimo. NÃO adicionar campos de
//    identificação (nome, email, CPF, telefone) sem revisão DPO.
// 2. Endpoint público de métricas NUNCA expõe comentários,
//    nem integrais nem parciais (snippets, nuvem de palavras,
//    análise de sentimento textual). Comentários ficam apenas
//    no painel interno autenticado.
// 3. Mínimo de 5 respostas para retorno de métricas públicas
//    (proteção contra reidentificação).
// 4. anonimizadoEm marca execução do cron de retenção (5 anos),
//    para auditoria PNTP.
model PesquisaSatisfacao {
  id              String      @id @default(cuid())
  organizacaoId   String
  organizacao     Organizacao @relation(fields: [organizacaoId], references: [id])
  avaliacao       Int
  setor           String
  comentario      String
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt
  anonimizadoEm   DateTime?

  @@index([organizacaoId, criadoEm])
  @@index([organizacaoId, avaliacao])
  @@index([organizacaoId, setor])
}

// ============ Anexos e historico genericos ============
// Usados por qualquer modulo. "entidade" + "registroId" apontam para o
// registro dono (ex.: TRATAMENTO + id do tratamento). A lista de
// entidades validas fica em src/services/entidades.js.

model Anexo {
  id             String      @id @default(cuid())
  organizacaoId  String
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id])
  entidade       String
  registroId     String
  nomeArquivo    String
  mimeType       String
  tamanho        Int
  conteudo       Bytes
  hashSha256     String
  enviadoPorId   String
  enviadoPor     Usuario     @relation(fields: [enviadoPorId], references: [id])
  criadoEm       DateTime    @default(now())

  @@index([organizacaoId, entidade, registroId])
}

enum AcaoHistorico {
  CRIAR
  EDITAR
  EXCLUIR
  STATUS
}

// diff: { campo: { antes, depois } }. Campos sensiveis ficam fora
// (ver CAMPOS_IGNORADOS / CAMPOS_OMITIDOS em src/services/historico.js).
// usuarioId null = acao sem usuario logado (ex.: DSAR pelo canal publico).
model HistoricoRegistro {
  id             String        @id @default(cuid())
  organizacaoId  String
  organizacao    Organizacao   @relation(fields: [organizacaoId], references: [id])
  entidade       String
  registroId     String
  acao           AcaoHistorico
  usuarioId      String?
  usuario        Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  diff           Json
  criadoEm       DateTime      @default(now())

  @@index([organizacaoId, entidade, registroId, criadoEm])
}

// ============ Etapa 2 PoC: setores, inventario e terceiros ============

model Setor {
  id            String       @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao  @relation(fields: [organizacaoId], references: [id])
  nome          String
  ativo         Boolean      @default(true)
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt
  tratamentos   Tratamento[]

  @@unique([organizacaoId, nome])
}

enum TipoSistema {
  APLICACAO
  BANCO_DADOS
  NUVEM
  FISICO
  OUTRO
}

enum TipoHospedagem {
  ON_PREMISE
  NUVEM
}

model SistemaInventario {
  id                     String              @id @default(cuid())
  organizacaoId          String
  organizacao            Organizacao         @relation(fields: [organizacaoId], references: [id])
  nome                   String
  tipo                   TipoSistema
  finalidade             String?
  responsavelId          String?
  responsavel            Usuario?            @relation("SistemaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  terceiroId             String?
  terceiro               Terceiro?           @relation(fields: [terceiroId], references: [id], onDelete: SetNull)
  categoriasDados        String[]
  formasCompartilhamento String?
  tipoHospedagem         TipoHospedagem?
  paisHospedagem         String?
  regiaoHospedagem       String?
  ativo                  Boolean             @default(true)
  criadoEm               DateTime            @default(now())
  atualizadoEm           DateTime            @updatedAt

  integracoesSaida       IntegracaoSistema[] @relation("IntegracaoOrigem")
  integracoesEntrada     IntegracaoSistema[] @relation("IntegracaoDestino")
  tratamentos            TratamentoSistema[]

  @@index([organizacaoId, ativo])
}

// Integracao entre sistemas. Gravada a partir do sistema de origem; a
// tela mostra as duas direcoes.
model IntegracaoSistema {
  origemId  String
  origem    SistemaInventario @relation("IntegracaoOrigem", fields: [origemId], references: [id], onDelete: Cascade)
  destinoId String
  destino   SistemaInventario @relation("IntegracaoDestino", fields: [destinoId], references: [id], onDelete: Cascade)

  @@id([origemId, destinoId])
  @@index([destinoId])
}

model TratamentoSistema {
  tratamentoId String
  tratamento   Tratamento        @relation(fields: [tratamentoId], references: [id], onDelete: Cascade)
  sistemaId    String
  sistema      SistemaInventario @relation(fields: [sistemaId], references: [id], onDelete: Cascade)

  @@id([tratamentoId, sistemaId])
  @@index([sistemaId])
}

enum PapelTerceiro {
  OPERADOR
  CONTROLADOR_CONJUNTO
  SUBOPERADOR
}

enum RiscoTerceiro {
  BAIXO
  MEDIO
  ALTO
}

enum RespostaQuestionario {
  SIM
  PARCIAL
  NAO
  NA
}

enum SituacaoAcao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

// risco: calculado pelo questionario (src/services/questionarioTerceiro.js)
// ou definido manualmente (riscoManual + riscoJustificativa). null =
// ainda nao avaliado.
model Terceiro {
  id                  String                         @id @default(cuid())
  organizacaoId       String
  organizacao         Organizacao                    @relation(fields: [organizacaoId], references: [id])
  razaoSocial         String
  cnpj                String?
  contatoNome         String?
  contatoEmail        String?
  papel               PapelTerceiro                  @default(OPERADOR)
  descricaoServico    String?
  contratoVigente     Boolean                        @default(false)
  contratoCritico     Boolean                        @default(false)
  aditivoLgpdAssinado Boolean                        @default(false)
  dataAditivo         DateTime?
  risco               RiscoTerceiro?
  riscoManual         Boolean                        @default(false)
  riscoJustificativa  String?
  ativo               Boolean                        @default(true)
  criadoEm            DateTime                       @default(now())
  atualizadoEm        DateTime                       @updatedAt

  respostas           RespostaQuestionarioTerceiro[]
  acoes               AcaoTerceiro[]
  sistemas            SistemaInventario[]
  compartilhamentos   CompartilhamentoTratamento[]

  @@index([organizacaoId, ativo])
  @@index([organizacaoId, risco])
}

// Uma linha por pergunta (perguntaId do questionario fixo no codigo).
// Reenvio atualiza a linha; o HistoricoRegistro do terceiro guarda o
// antes/depois de cada resposta.
model RespostaQuestionarioTerceiro {
  id              String               @id @default(cuid())
  organizacaoId   String
  organizacao     Organizacao          @relation(fields: [organizacaoId], references: [id])
  terceiroId      String
  terceiro        Terceiro             @relation(fields: [terceiroId], references: [id], onDelete: Cascade)
  perguntaId      String
  resposta        RespostaQuestionario
  observacao      String?
  respondidoPorId String
  respondidoPor   Usuario              @relation("RespostaTerceiroAutor", fields: [respondidoPorId], references: [id])
  respondidoEm    DateTime             @default(now())

  @@unique([terceiroId, perguntaId])
}

model AcaoTerceiro {
  id            String       @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao  @relation(fields: [organizacaoId], references: [id])
  terceiroId    String
  terceiro      Terceiro     @relation(fields: [terceiroId], references: [id], onDelete: Cascade)
  descricao     String
  responsavelId String?
  responsavel   Usuario?     @relation("AcaoTerceiroResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  prazo         DateTime?
  situacao      SituacaoAcao @default(PENDENTE)
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  @@index([terceiroId])
  @@index([organizacaoId, situacao])
}

// ============ Etapa 3 PoC: treinamento, incidentes, descarte ============

// Um registro por modulo concluido. Trilha concluida = todos os modulos
// da trilha (TRILHAS_BASE em routes/treinamento.js) com registro.
model ProgressoTreinamento {
  id            String      @id @default(cuid())
  usuarioId     String
  usuario       Usuario     @relation(fields: [usuarioId], references: [id])
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
  trilhaId      String
  moduloId      String
  concluidoEm   DateTime    @default(now())

  @@unique([usuarioId, trilhaId, moduloId])
  @@index([organizacaoId, trilhaId])
}

// Emitido quando a trilha e concluida. Guarda copia de nome/trilha/carga
// para o certificado continuar verificavel mesmo se o conteudo mudar.
// codigo e o que vai impresso no PDF e na verificacao publica.
model CertificadoTreinamento {
  id               String      @id @default(cuid())
  codigo           String      @unique
  usuarioId        String
  usuario          Usuario     @relation(fields: [usuarioId], references: [id])
  organizacaoId    String
  organizacao      Organizacao @relation(fields: [organizacaoId], references: [id])
  trilhaId         String
  trilhaTitulo     String
  nomeUsuario      String
  nomeOrganizacao  String
  cargaHorariaMin  Int
  concluidoEm      DateTime
  emitidoEm        DateTime    @default(now())

  @@unique([usuarioId, trilhaId])
}

enum TipoRegistroIncidente {
  REAL
  SIMULADO
}

model ProvidenciaIncidente {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
  incidenteId   String
  incidente     Incidente   @relation(fields: [incidenteId], references: [id], onDelete: Cascade)
  descricao     String
  data          DateTime
  responsavelId String?
  responsavel   Usuario?    @relation("ProvidenciaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoPorId   String?
  criadoEm      DateTime    @default(now())

  @@index([incidenteId])
}

// Registro de descarte de dados de um tratamento do ROPA. O prazo de
// retencao volta a contar da dataDescarte mais recente (alerta
// RETENCAO_VENCIDA em routes/conformidade.js).
model RegistroDescarte {
  id            String      @id @default(cuid())
  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
  tratamentoId  String
  tratamento    Tratamento  @relation(fields: [tratamentoId], references: [id])
  dataDescarte  DateTime
  descricao     String
  quantidade    Int?
  metodo        String
  responsavelId String?
  responsavel   Usuario?    @relation("DescarteResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoPorId   String?
  criadoEm      DateTime    @default(now())

  @@index([organizacaoId, tratamentoId])
}
